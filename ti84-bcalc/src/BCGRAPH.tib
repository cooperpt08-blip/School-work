# GRAPH ANALYZER module
Lbl M
Menu("GRAPH ANALYZER","TYPE F(X)",A,"F=N/D (EXACT)",1,"F + MY WINDOW",2,"BACK",Q)
Lbl A
prgmBCINF
prgmBCAUTO
Goto M
Lbl V
ClrHome
Disp "N,D MUST BE","POLYNOMIALS","(DEGREE<=8)."
Pause
Goto M
Lbl 1
ClrHome
Disp "F=N(X)/D(X)","N,D POLYNOMIALS","D=1 IF POLY"
Input "N(X)=",Str5
Input "D(X)=",Str6
"("+Str5+")/("+Str6+")"→Str1
1309→K
ClrHome
Disp "WORKING..."
prgmBCRAT
If U
Goto V
prgmBCEXA
Goto M
Lbl 2
prgmBCINF
ClrHome
Disp "X-WINDOW TO SCAN","EX: -10 TO 10"
Input "LEFT X=",L
Input "RIGHT X=",R
If R≤L
L+20→R
prgmBCNUM
Goto M
Lbl Q
