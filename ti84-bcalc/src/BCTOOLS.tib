# QUICK TOOLS module
Lbl M
Menu("QUICK TOOLS","QUADRATIC EQN",1,"POLY ROOTS",2,"SOLVE F(X)=C",3,"DEC->FRAC/ROOT",5,"BACK",Q)
Lbl 1
ClrHome
Disp "AX²+BX+C=0"
Input "A=",A
Input "B=",B
Input "C=",C
B²-4A*C→D
ClrHome
1→W
"DISCRIMINANT="→Str0
D→θ
prgmBCPV
If A=0
Then
"A=0: LINEAR"→Str0
prgmBCPR
"X="→Str0
⁻C/B→θ
prgmBCPV
Else
If D<0
Then
"NO REAL ROOTS"→Str0
prgmBCPR
Else
⁻B→θ
prgmBCSTR
"X=("+Str9+"+-√("→Str0
D→θ
prgmBCSTR
Str0+Str9+"))/"→Str0
2A→θ
prgmBCSTR
Str0+Str9→Str0
prgmBCPR
"X1="→Str0
(⁻B-√(D))/(2A)→θ
prgmBCPV
"X2="→Str0
(⁻B+√(D))/(2A)→θ
prgmBCPV
End
"VERTEX "→Str0
⁻D/(4A)→T
⁻B/(2A)→A
T→B
prgmBCXY
End
prgmBCEND
Goto M
Lbl 2
ClrHome
Disp "TYPE POLYNOMIAL","IN X (DEG<=8)"
Input "P(X)=",Str8
prgmBCCOEF
If U
Goto 6
ʟPC→ʟPA
prgmBCTRIM
prgmBCROOT
ClrHome
1→W
"=REAL ROOTS="→Str0
prgmBCPR
If ʟRT(1)=0
Then
"NONE"→Str0
prgmBCPR
End
For(I,2,ʟRT(1)+1)
"X="→Str0
ʟRT(I)→θ
prgmBCPV
End
prgmBCEND
Goto M
Lbl 3
prgmBCINF
ClrHome
Input "SOLVE F(X)=",C
Disp "X-WINDOW TO SCAN"
Input "LEFT X=",L
Input "RIGHT X=",R
{C}→ʟTG
"("+Str1+")-ʟTG(1)"→Str8
prgmBCSETY
ClrHome
Disp "WORKING..."
{L,R}→ʟEX
{0,0}→ʟET
0→E
String►Equ("Y₁",Y₄)
0→C
64→N
prgmBCSCAN
SortA(ʟEX,ʟET)
ClrHome
1→W
"=SOLUTIONS="→Str0
prgmBCPR
0→J
For(I,1,dim(ʟEX))
If ʟET(I)=10
Then
J+1→J
"X="→Str0
ʟEX(I)→θ
prgmBCPV
End
End
If J=0
Then
"NONE IN WINDOW"→Str0
prgmBCPR
End
Str1→Str8
prgmBCSETY
prgmBCEND
Goto M
Lbl 5
ClrHome
Input "DECIMAL=",A
ClrHome
1→W
"VALUE="→Str0
A→θ
prgmBCPV
A→θ
prgmBCHNT
If Q=0
Then
"NO SIMPLE FORM"→Str0
prgmBCPR
Else
"="+Str8→Str0
prgmBCPR
End
prgmBCEND
Goto M
Lbl 6
ClrHome
Disp "NOT A POLYNOMIAL","OF DEGREE<=8"
Pause
Goto M
Lbl Q
