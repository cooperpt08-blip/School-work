# DERIVATIVES module
Lbl M
Menu("DERIVATIVES","F,F',F'' AT X",1,"CHECK MY F'",2,"F'(X) FORMULA",3,"RULES SHEET",5,"BACK",Q)
Lbl 1
prgmBCINF
Lbl 6
ClrHome
Input "AT X=",A
prgmBCFD
ClrHome
1→W
"X="→Str0
A→θ
prgmBCPV
If U=1 or U=3
Then
"F UNDEFINED HERE"→Str0
prgmBCPR
Else
"F(X)="→Str0
F→θ
prgmBCPV
If U=2
Then
"F' UNDEFINED HERE"→Str0
prgmBCPR
"(EDGE OF DOMAIN)"→Str0
prgmBCPR
Else
"F'(X)~"→Str0
D→θ
prgmBCPV
"F''(X)~"→Str0
S→θ
prgmBCPV
End
End
prgmBCEND
Menu("NEXT?","NEW X, SAME F",6,"BACK",M)
Lbl 2
prgmBCINF
Menu("CHECK WHICH?","MY F'(X)",7,"MY F''(X)",8)
Lbl 7
1→N
Goto 9
Lbl 8
2→N
Lbl 9
ClrHome
Disp "TYPE YOUR ANSWER","USING X"
Input "ANS=",Str2
String►Equ(Str2,Y₄)
prgmBCVER
ClrHome
1→W
C→θ
prgmBCSTR
"TESTED "+Str9+" X'S"→Str0
prgmBCPR
If C<3
Then
"TOO FEW VALID X"→Str0
prgmBCPR
"(DOMAIN?) RETYPE"→Str0
prgmBCPR
Else
If J=0
Then
"ALL MATCH!"→Str0
prgmBCPR
"YOUR ANSWER IS"→Str0
prgmBCPR
"CORRECT/EQUIV."→Str0
prgmBCPR
Else
J→θ
prgmBCSTR
Str9+" MISMATCH(ES)"→Str0
prgmBCPR
"AT X="→Str0
B→θ
prgmBCPV
"YOURS="→Str0
R→θ
prgmBCPV
"TRUE~"→Str0
M→θ
prgmBCPV
End
End
prgmBCEND
Goto M
Lbl 3
prgmBCINF
1→N
Lbl A
ClrHome
Disp "WORKING..."
{1}→ʟDV
prgmBCSYM
If U
Goto 4
Str0→Str6
String►Equ(Str6,Y₄)
ClrHome
1→W
"F'(X)="→Str0
If N=2
"F''(X)="→Str0
prgmBCPR
prgmBCPLG
prgmBCVER
"(NOT SIMPLIFIED)"→Str0
If J=0 and C≥3
"CHECKED: CORRECT"→Str0
If J
"CHECK FAILED!"→Str0
prgmBCPR
prgmBCEND
Equ►String(Y₁,Str1)
If N=2
Goto M
Menu("NEXT?","F''(X) TOO",B,"BACK",M)
Lbl B
Equ►String(Y₄,Str1)
2→N
Goto A
Lbl 4
Equ►String(Y₁,Str1)
ClrHome
Disp "CAN'T DO THIS F","(TRIG/ABS/ODD","INPUT?). DO IT","BY HAND, THEN","USE CHECK MY F'"
Pause
Goto M
Lbl 5
prgmBCFORM
Goto M
Lbl Q
